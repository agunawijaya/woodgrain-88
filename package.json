{
  "name": "woodgrain-88",
  "version": "0.1.0",
  "private": true,
  "description": "A free, open-source collection of modern web games reborn from a 1988 32-in-1 game cartridge.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @woodgrain-88/hall dev",
    "build": "pnpm --filter @woodgrain-88/hall build",
    "preview": "pnpm --filter @woodgrain-88/hall preview",
    "test": "vitest run && pnpm test:crew",
    "test:watch": "vitest",
    "test:crew": "node --test \"tools/crew/tests/*.test.mjs\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "e2e": "pnpm build && playwright test",
    "shots": "pnpm build && cross-env SHOTS=1 playwright test --project=shots",
    "check": "tsx scripts/check/index.ts",
    "docs:games": "tsx scripts/docs-games.ts",
    "crew": "node tools/crew/crew.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
